VITE_CMS_ENABLED=false
VITE_CMS_BASE_URL=https://blog.innotech.global
VITE_CMS_HOME_ENABLED=true
VITE_CMS_HOME_PATH=/wp-json/innotech/v1/content/home
VITE_CMS_HOME_SLUG_PREFIX=innotech-home-content
VITE_CMS_BLOG_ENABLED=true
VITE_CMS_BLOG_PER_PAGE=50

# Optional generic content API. When unset, fetchJsonFromApi() short-circuits
# and the site falls back to the bundled JSON in src/content/.
VITE_CONTENT_API_BASE_URL=

# INLEARN's Strapi backend. Empty means sign-in, registration, password reset
# and provider sign-in all refuse rather than pretend to work. Set it to the
# running Strapi (http://localhost:1337 while developing) to switch them on.
VITE_INLEARN_API_URL=

# Show INLEARN in navigation and search.
VITE_INLEARN_ENABLED=false

# GitHub Pages and the production Docker build set this to true. Local
# development uses the full INLEARN module by default.
VITE_INLEARN_COMING_SOON=false

# CMS pictures are converted to WebP on the way through, because WordPress
# serves what editors upload and a PNG photograph is roughly fourteen times the
# size of the same picture as WebP. Set this to an empty string to turn the
# conversion off and serve WordPress's own files; the originals stay as the
# fallback either way, so nothing breaks if the service is down.
VITE_IMAGE_PROXY=https://images.weserv.nl/
